{
  "schema_version": 1,
  "schema_revision": "1.1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "status",
    "source_image",
    "canvas"
  ],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "enum": [
        "imported",
        "draft",
        "measured",
        "analyzed",
        "validated",
        "ready"
      ]
    },
    "source_image": {
      "type": "string"
    },
    "image_sha256": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "canvas": {
      "type": "object",
      "properties": {
        "page": {
          "type": "string"
        },
        "width_in": {
          "type": "number"
        },
        "height_in": {
          "type": "number"
        },
        "dpi": {
          "type": "integer"
        },
        "background": {
          "type": "string"
        }
      }
    },
    "map_frame": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      }
    },
    "title": {
      "type": "object"
    },
    "legend": {
      "type": "object"
    },
    "scale_bar": {
      "type": "object"
    },
    "north_arrow": {
      "type": "object"
    },
    "palette": {
      "type": "object"
    },
    "typography": {
      "type": "object"
    },
    "labeling": {
      "type": "object"
    },
    "export": {
      "type": "object"
    },
    "measured": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "measured_at": {
          "type": "string"
        },
        "pixel_size": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "figure_bbox": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "figure_size": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "aspect": {
          "type": "number"
        },
        "assumed_width_in": {
          "type": "number"
        },
        "canvas_height_in": {
          "type": "number"
        },
        "dpi": {
          "type": "integer"
        },
        "dpi_source": {
          "type": "string"
        },
        "h_lines": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "v_lines": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "palette_top": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "hex": {
                "type": "string"
              },
              "share": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "role",
          "x",
          "y",
          "w",
          "h"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "w": {
            "type": "number"
          },
          "h": {
            "type": "number"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "pitfalls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue",
          "check"
        ],
        "properties": {
          "issue": {
            "type": "string"
          },
          "check": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "warn",
              "error"
            ]
          }
        }
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "force": {
          "type": "boolean"
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}

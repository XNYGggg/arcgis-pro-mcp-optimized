# Normalise to LF in the repository and check out CRLF everywhere.
# SHA256SUMS.txt lists the bytes a customer actually gets, so the checkout has
# to be the same on every machine -- text=auto alone would depend on each
# contributor's core.autocrlf.
* text=auto eol=crlf

*.cs      text eol=crlf
*.csproj  text eol=crlf
*.daml    text eol=crlf
*.json    text eol=crlf
*.md      text eol=crlf
*.toml    text eol=crlf
*.yml     text eol=crlf

# Batch files are read by cmd.exe, which wants CRLF. PowerShell does not care,
# but these are Windows-only scripts and CRLF is what an editor there expects.
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ArcGIS Pro's Python runs these; keep them LF so the interpreter never sees
# carriage returns in source.
*.pyt text eol=lf
*.py  text eol=lf

# The packaged add-in is a zip; never let git treat it as text or try to
# normalise its line endings.
*.esriAddinX binary

# The single-file installer is generated: mostly base64, and it changes in
# full on every build. Marking it binary keeps diffs from trying to render it,
# and keeps the payload byte-for-byte what the build produced. This has to
# come after the *.cmd rule above -- the last matching line wins.
dist/Install-ArcGISProMCP.cmd binary

*.png binary
*.gif binary
